#version 450
// Reference compute kernel for the host-Vulkan execution rail.
// Mirrors the captured Metal kernel `kernel void k(device float* b, uint i){ b[i] = b[i] + 1.0; }`.
// This is the Vulkan-dialect INTERFACE the air.*->SPIR-V transform (path B) must target:
//   - one storage buffer at descriptor set 0, binding 0 (the Metal `device float* b` -> air.buffer)
//   - gl_GlobalInvocationID.x as the thread index (the Metal `thread_position_in_grid` -> air builtin)
//   - a GLCompute entry point `main` with a LocalSize (the dispatch's threads-per-threadgroup)
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer B { float data[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    data[i] = data[i] + 1.0;
}
