From 3f4c0351d05ad9fec9fd133b9cfc6386e2ea5025 Mon Sep 17 00:00:00 2001
From: Anees Iqbal <hello@aneesiqbal.ai>
Date: Sat, 11 Jul 2026 20:40:22 +0300
Subject: [PATCH 5/5] vmapple: gfx-device property for apple-gfx-mmio Reims VGPU slots

Select the paravirt GPU backing REIMS_VGPU_GFX/REIMS_VGPU_IOSFC via a machine property
(default apple-gfx-mmio). Product-device alternatives were removed; only
Apple's ParavirtualizedGraphics path remains valid.
---
 hw/display/Kconfig      |  1 +
 hw/display/trace-events | 17 +++++++++++++++
 hw/vmapple/vmapple.c    | 47 +++++++++++++++++++++++++++++++++++++++--
 3 files changed, 63 insertions(+), 2 deletions(-)

diff --git a/hw/display/Kconfig b/hw/display/Kconfig
index b3593fe9..c30a72fa 100644
--- a/hw/display/Kconfig
+++ b/hw/display/Kconfig
@@ -153,3 +153,4 @@ config MAC_PVG_PCI
     bool
     depends on MAC_PVG && PCI
     default y if PCI_DEVICES
+
diff --git a/hw/display/trace-events b/hw/display/trace-events
index 4bfc457f..297de6c6 100644
--- a/hw/display/trace-events
+++ b/hw/display/trace-events
@@ -226,3 +226,20 @@ apple_gfx_iosfc_unmap_memory(void *a, void *b, void *c, void *d, void *e, void *
 apple_gfx_iosfc_unmap_memory_region(void* mem, void *region) "unmapping @ %p from memory region %p"
 apple_gfx_iosfc_raise_irq(uint32_t vector) "vector=0x%x"
 
+
+# Sampled-texture resolve failure for a draw bind: reason is ReimsVgpuResourceResolveReason
+# (0=none/post-resolve sample fail); fmt/w/h are 0 when resolve itself fails.
+# Extra type-2 fields when sampled convert fails after geometry resolve (fmt may be 0).
+# Main-loop stall instrumentation: begin/end pairs around every point where the
+# device blocks the drain (or a vCPU MMIO doorbell) on in-flight backend work.
+# A wedged boot's trace TAIL names the stall site: a *_begin with no matching
+# *_end is the loop the device is stuck in; worker begin/end durations expose a
+# slow backend job (e.g. a Vulkan-rail shader translate) directly.
+# Temporary content-vs-publish oracle (scanout gap map G1/G4). reason: 1=0x3b/0x28
+# boundary sample, 2=type-11 0x73 LOAD writeback with partial scissor. outside_clobber
+# counts strided samples outside the job scissor union where guest-pre != job rgba
+# (full-FB store would destroy those pixels). outside_seed_drift: pre != seed outside
+# (another writer landed between seed and complete). unique_blocks: 32x32 mean diversity
+# on boundary samples (width/height omitted — use t11_register / scanout_frame).
+# Probe-only — remove after the isolation boot.
+
diff --git a/hw/vmapple/vmapple.c b/hw/vmapple/vmapple.c
index b7993b6f..9bf217d3 100644
--- a/hw/vmapple/vmapple.c
+++ b/hw/vmapple/vmapple.c
@@ -69,6 +69,7 @@ struct VMAppleMachineState {
     MemoryRegion fw_mr;
     MemoryRegion ecam_alias;
     uint64_t uuid;
+    char *gfx_device;
 };
 
 #define TYPE_VMAPPLE_MACHINE   MACHINE_TYPE_NAME("vmapple")
@@ -211,9 +212,17 @@ static void create_gfx(VMAppleMachineState *vms, MemoryRegion *mem)
 {
     int irq_gfx = vms->irqmap[VMAPPLE_APV_GFX];
     int irq_iosfc = vms->irqmap[VMAPPLE_APV_IOSFC];
+    DeviceState *gfx_dev;
     SysBusDevice *gfx;
 
-    gfx = SYS_BUS_DEVICE(qdev_new("apple-gfx-mmio"));
+    /*
+     * The platform's fixed REIMS_VGPU_GFX/REIMS_VGPU_IOSFC slots are backed by
+     * apple-gfx-mmio (ParavirtualizedGraphics.framework host side).
+     * Sysbus layout: mmio 0/irq 0 = gfx window, mmio 1/irq 1 = IOSurface mapper.
+     */
+    gfx_dev = qdev_new(vms->gfx_device);
+    gfx_dev->id = g_strdup("reims-vgpu-gfx");
+    gfx = SYS_BUS_DEVICE(gfx_dev);
     sysbus_mmio_map(gfx, 0, vms->memmap[VMAPPLE_APV_GFX].base);
     sysbus_mmio_map(gfx, 1, vms->memmap[VMAPPLE_APV_IOSFC].base);
     sysbus_connect_irq(gfx, 0, qdev_get_gpio_in(vms->gic, irq_gfx));
@@ -627,15 +636,49 @@ static void vmapple_machine_class_init(ObjectClass *oc, const void *data)
                      G_N_ELEMENTS(vmapple_compat_defaults));
 }
 
+static char *vmapple_get_gfx_device(Object *obj, Error **errp)
+{
+    VMAppleMachineState *vms = VMAPPLE_MACHINE(obj);
+
+    return g_strdup(vms->gfx_device);
+}
+
+static void vmapple_set_gfx_device(Object *obj, const char *value,
+                                   Error **errp)
+{
+    VMAppleMachineState *vms = VMAPPLE_MACHINE(obj);
+
+    if (strcmp(value, "apple-gfx-mmio") != 0) {
+        error_setg(errp, "invalid gfx-device '%s' (valid: apple-gfx-mmio)", value);
+        return;
+    }
+
+    g_free(vms->gfx_device);
+    vms->gfx_device = g_strdup(value);
+}
+
 static void vmapple_instance_init(Object *obj)
 {
     VMAppleMachineState *vms = VMAPPLE_MACHINE(obj);
 
     vms->irqmap = irqmap;
+    vms->gfx_device = g_strdup("apple-gfx-mmio");
 
     object_property_add_uint64_ptr(obj, "uuid", &vms->uuid,
                                    OBJ_PROP_FLAG_READWRITE);
     object_property_set_description(obj, "uuid", "Machine UUID (SDOM)");
+    object_property_add_str(obj, "gfx-device", vmapple_get_gfx_device,
+                            vmapple_set_gfx_device);
+    object_property_set_description(obj, "gfx-device",
+                                    "Paravirt GPU device backing the Reims VGPU "
+                                    "slots (apple-gfx-mmio)");
+}
+
+static void vmapple_instance_finalize(Object *obj)
+{
+    VMAppleMachineState *vms = VMAPPLE_MACHINE(obj);
+
+    g_free(vms->gfx_device);
 }
 
 static const TypeInfo vmapple_machine_info = {
@@ -644,6 +687,7 @@ static const TypeInfo vmapple_machine_info = {
     .instance_size = sizeof(VMAppleMachineState),
     .class_init    = vmapple_machine_class_init,
     .instance_init = vmapple_instance_init,
+    .instance_finalize = vmapple_instance_finalize,
     .interfaces    = aarch64_machine_interfaces
 };
 
@@ -652,4 +696,3 @@ static void machvmapple_machine_init(void)
     type_register_static(&vmapple_machine_info);
 }
 type_init(machvmapple_machine_init);
-
-- 
2.54.0

