+    if (!s->usb_input || size <= 0) {
+        return;
+    }
+    if (s->usb_input->len >= max_rx) {
+        return;
+    }
+    if (s->usb_input->len + (guint)size > max_rx) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "vmapple-bdif: USB rx overflow, dropping %d bytes\n",
+                      size);
