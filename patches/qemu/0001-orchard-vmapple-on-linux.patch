+static void vusb_cmd(VMAppleBdifState *s, uint64_t gp_addr)
+{
+    uint64_t words[16];
+    VUsbDesc desc;
+    MemTxResult dma_result;
+    unsigned i;
+
+    dma_result = dma_memory_read(&address_space_memory, gp_addr, words,
