+    memcpy(&desc, words, sizeof(desc));
+    desc.addr = le64_to_cpu(desc.addr);
+    desc.len = le32_to_cpu(desc.len);
+    desc.next = le16_to_cpu(desc.next);
+    desc.flags = le16_to_cpu(desc.flags);
