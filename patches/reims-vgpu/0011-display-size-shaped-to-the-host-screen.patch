index 571bb9cb..2eb1a655 100644
--- a/crates/reims-vgpu-config/src/lib.rs
+++ b/crates/reims-vgpu-config/src/lib.rs
@@ -1274,6 +1274,17 @@ pub const DISPLAY_MODE: &str = "REIMS_VGPU_DISPLAY_MODE";
 /// Unset is 120 Hz, as before. A value outside the list is refused on the
 /// failure channel and 120 Hz is used.
 pub const DISPLAY_HZ: &str = "REIMS_VGPU_DISPLAY_HZ";
+
+/// **Not a switch: a size.** The guest display's one mode, as `WIDTHxHEIGHT`,
+/// read through [`dimensions`].
+///
+/// For a host whose screen is not 16:9 — a phone is nearer 19.5:9 — so the
+/// guest's desktop can have the screen's own shape instead of sitting between
+/// black bars. When set and in bounds it is the only mode offered, and the panel
+/// the guest is told about takes the same shape, so its pixels stay square. It
+/// takes precedence over [`DISPLAY_MODE`]. A value that does not parse, or is
+/// out of bounds, is refused on the failure channel and ignored.
+pub const DISPLAY_SIZE: &str = "REIMS_VGPU_DISPLAY_SIZE";
 }
 
 /// What one variable says, including the two ways it says nothing usable.
@@ -1366,6 +1377,37 @@ pub enum Choice {
     Refused(String),
 }
 
+/// What a `WIDTHxHEIGHT` variable says.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Dimensions {
+    /// Nothing set.
+    Unset,
+    /// A width and a height, as written. The caller checks them against what it
+    /// can do; parsing is not permission.
+    Named(u32, u32),
+    /// Set to something that is not `WIDTHxHEIGHT`, carrying the raw text.
+    Refused(String),
+}
+
+/// Read `name` as `WIDTHxHEIGHT` (`x` or `X`, decimal, no spaces inside).
+pub fn dimensions(name: &str) -> Dimensions {
+    let Some(raw) = std::env::var_os(name) else {
+        return Dimensions::Unset;
+    };
+    let value = raw.to_string_lossy().into_owned();
+    let trimmed = value.trim();
+    if trimmed.is_empty() {
+        return Dimensions::Unset;
+    }
+    let parsed = trimmed
+        .split_once(['x', 'X'])
+        .and_then(|(w, h)| Some((w.parse::<u32>().ok()?, h.parse::<u32>().ok()?)));
+    match parsed {
+        Some((w, h)) => Dimensions::Named(w, h),
+        None => Dimensions::Refused(value),
+    }
+}
+
 /// Read `name` as a choice among `allowed`, ASCII-case-insensitively.
 ///
 /// `allowed` is the caller's list because only the caller knows it: the set of
@@ -1512,6 +1554,19 @@ mod tests {
         with_probe(value, || choice("REIMS_VGPU_TEST_PROBE", allowed))
     }
 
+    /// A size is two decimal numbers around an `x`, or it is handed back.
+    #[test]
+    fn dimensions_parse_width_by_height_or_refuse() {
+        let probe = |v| with_probe(v, || dimensions("REIMS_VGPU_TEST_PROBE"));
+        assert_eq!(probe(None), Dimensions::Unset);
+        assert_eq!(probe(Some(" ")), Dimensions::Unset);
+        assert_eq!(probe(Some("1170x540")), Dimensions::Named(1170, 540));
+        assert_eq!(probe(Some(" 960X540 ")), Dimensions::Named(960, 540));
+        assert_eq!(probe(Some("960")), Dimensions::Refused("960".to_owned()));
+        assert_eq!(probe(Some("wide")), Dimensions::Refused("wide".to_owned()));
+        assert_eq!(probe(Some("1x-2")), Dimensions::Refused("1x-2".to_owned()));
+    }
+
     /// A choice answers with one of the caller's own strings, or with the raw
     /// text it could not place — and never with a fourth thing.
     ///
