+++ b/crates/reims-vgpu/src/runtime/drain/tests.rs
@@ -3885,6 +3885,40 @@ fn delivered_vbl_cadence_equals_the_advertised_refresh_rate() {
     );
 }
 
+/// The panel follows the native mode's shape: unchanged for 16:9, and for a
+/// phone-shaped mode wide enough that its pixels stay square to within the
+/// centimetre the guest's EDID keeps.
+#[test]
+fn the_panel_takes_the_native_modes_shape() {
+    assert_eq!(
+        display_panel_mm(None),
+        (DISPLAY_WIDTH_MM, DISPLAY_HEIGHT_MM)
+    );
+    assert_eq!(display_panel_mm(Some((1920, 1080))), (480, 270));
+    assert_eq!(display_panel_mm(Some((960, 540))), (480, 270));
+    let (w, h) = display_panel_mm(Some((1170, 540)));
+    assert_eq!(h, DISPLAY_HEIGHT_MM);
+    assert_eq!(w % 10, 0, "whole centimetres");
+    let panel = f64::from(w) / f64::from(h);
+    let pixels = 1170.0 / 540.0;
+    assert!(
+        (panel - pixels).abs() / pixels < 0.02,
+        "{panel} vs {pixels}"
+    );
+
+    assert!(display_size_in_bounds(1170, 540));
+    assert!(display_size_in_bounds(1920, 1080));
+    assert!(!display_size_in_bounds(1171, 540), "odd width");
+    assert!(
+        !display_size_in_bounds(2560, 1440),
+        "more pixels than 1920x1080"
+    );
+    assert!(
+        !display_size_in_bounds(320, 240),
+        "fewer pixels than 640x360"
+    );
+}
+
 /// The rate a process chose and the interval its limiter paces at are one
 /// number: with nothing set they are the defaults the test above pins.
 #[test]
