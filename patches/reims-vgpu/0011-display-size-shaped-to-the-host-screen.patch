+/// The panel the guest is told it has, in millimetres: the default 48 x 27 cm
+/// for a 16:9 native mode, and otherwise the same height with the width that
+/// makes the native mode's pixels square, in whole centimetres because that is
+/// all the guest's EDID keeps. See `DISPLAY_WIDTH_MM` for why the two must agree.
+fn display_panel_mm(native: Option<(u16, u16)>) -> (u16, u16) {
+    let Some((w, h)) = native.filter(|(w, h)| *w > 0 && *h > 0) else {
+        return (DISPLAY_WIDTH_MM, DISPLAY_HEIGHT_MM);
+    };
+    let width_cm =
+        (u32::from(DISPLAY_HEIGHT_MM) * u32::from(w) + u32::from(h) * 5) / (u32::from(h) * 10);
+    let width_mm = (width_cm * 10).clamp(100, 1000) as u16;
+    (width_mm, DISPLAY_HEIGHT_MM)
+}
+
+/// The bounds a `REIMS_VGPU_DISPLAY_SIZE` mode must sit inside: even sides,
+/// no fewer pixels than 640x360 and no more than 1920x1080 holds, and no side
+/// past what the scanout path takes.
+fn display_size_in_bounds(w: u32, h: u32) -> bool {
+    w % 2 == 0
+        && h % 2 == 0
+        && (320..=2560).contains(&w)
+        && (240..=1440).contains(&h)
+        && w * h >= 640 * 360
+        && w * h <= 1920 * 1080
+}
+
 fn select_display_modes() -> Vec<(u16, u16)> {
+    match crate::config::dimensions(crate::config::DISPLAY_SIZE) {
+        crate::config::Dimensions::Unset => {}
+        crate::config::Dimensions::Named(w, h) if display_size_in_bounds(w, h) => {
+            crate::observe::fail(format!(
+                "display_size_adopted mode={w}x{h} panel_mm={:?}",
+                display_panel_mm(Some((w as u16, h as u16)))
+            ));
+            return vec![(w as u16, h as u16)];
+        }
+        crate::config::Dimensions::Named(w, h) => {
+            crate::observe::fail(format!(
+                "display_size_refused value={w}x{h} (out of bounds: even sides, \
+                 640x360..1920x1080 pixels; the other modes are offered)"
+            ));
+        }
+        crate::config::Dimensions::Refused(raw) => {
+            crate::observe::fail(format!(
+                "display_size_refused value={raw:?} (not WIDTHxHEIGHT; the other modes are offered)"
+            ));
+        }
+    }
     let default = vec![
         (DISPLAY_MODE_EFI_W, DISPLAY_MODE_EFI_H),
         (DISPLAY_MODE1_W, DISPLAY_MODE1_H),
diff --git a/crates/reims-vgpu/src/runtime/drain/tests.rs b/crates/reims-vgpu/src/runtime/drain/tests.rs
index 2e9136cd..1532f91b 100644
