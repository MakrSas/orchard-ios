+/// The [`crate::backend::metal::sampled_cache`] key of a sampled bind, and the
+/// texture's geometry, when the bind is the plain path of [`load_sampled_rgba`]
+/// — a texture sampled at level 0 in its own format, not a buffer texture, not
+/// a mapper-ref-texture surface, not a view. `None` sends the bind down that
+/// function unchanged.
+///
+/// The checks are that function's own, in its order, so a bind reaches this key
+/// exactly when it would have reached `load_linear_texture_rgba_at_level(.., 0,
+/// None)`; and the key covers every input that decode reads: the descriptor's
+/// geometry, pitch and format, and the bytes of every row it converts, read
+/// through the same translation.
+fn plain_linear_cache_key<M: HostMemory + HostOps>(
+    state: &mut DeviceState,
+    host: &mut M,
+    task_id: u32,
+    texture_ref: u32,
+) -> Option<(u32, u32, u64)> {
+    if texture_ref == 0
+        || buffer_texture_descriptor(state, host, task_id, texture_ref, None).is_some()
+        || objects::resolve_mapper_ref_texture(state, host, task_id, texture_ref).is_some()
+        || resolve_texture_view(state, host, task_id, texture_ref).is_some()
+    {
+        return None;
+    }
+    let (_entry, desc_bytes) = objects::resolve_descriptor(
+        state,
+        host,
+        task_id,
+        texture_ref,
+        &[OBJECT_TYPE_TEXTURE, OBJECT_TYPE_TEXTURE_GENERATE_MIPMAPS],
+    )
+    .ok()?;
+    let tex = decode_texture_descriptor(&desc_bytes).ok()?;
+    tex.declared_pixel_format()?;
+    let base_fmt = tex.pixel_format;
+    let sample_fmt = effective_view_sample_format(base_fmt, None)?;
+    let (gva, layout) = tex.level_gva(0, state.page_shift)?;
+    let (w, h, bpr) = (layout.width, layout.height, layout.row_stride);
+    let tight = pixel_format::tight_row_bytes(w, base_fmt)?;
+    if bpr > u32::MAX as u64 || (bpr as u32) < tight || w == 0 || h == 0 {
+        return None;
+    }
+    let mut hash = crate::backend::metal::sampled_cache::ContentHash::new(&[
+        u64::from(w),
+        u64::from(h),
+        bpr,
+        u64::from(base_fmt),
+        u64::from(sample_fmt),
+        u64::from(tight),
+    ]);
+    let mut row = vec![0u8; tight as usize];
+    for y in 0..h {
+        let row_gva = gva.checked_add((y as u64).checked_mul(bpr)?)?;
+        gva_mem::read_task_gva_by_id(
+            host,
+            &state.tasks,
+            task_id,
+            row_gva,
+            &mut row,
+            state.page_shift,
+        )
+        .ok()?;
+        hash.update(&row);
+    }
+    Some((w, h, hash.finish()))
+}
