+        assert!(state.set_object_list(1, 0, 32));
+
+        // Padded 4x2 BGRA8: pitch 32 for 16 bytes of texels, so the padding is
+        // outside what the decode reads and must be outside the key too.
+        let tex_ref = 6u32;
+        let body = TEXTURE_DESC_BASE_LEN;
+        let mut b = vec![0u8; body];
+        st64(&mut b[0..], 0x1000);
+        st32(&mut b[8..], 1);
+        st16(&mut b[TEXTURE_DESC_MIPMAP_LEVEL_COUNT..], 1);
+        st32(&mut b[TEXTURE_DESC_USED_SIZE..], 32 * 2);
+        st32(&mut b[TEXTURE_DESC_ROW_STRIDE..], 32);
+        st32(&mut b[TEXTURE_DESC_WIDTH..], 4);
+        st32(&mut b[TEXTURE_DESC_WIDTH + 4..], 2);
+        st16(&mut b[TEXTURE_DESC_PIXEL_FORMAT..], MTL_FORMAT_BGRA8_UNORM);
+        let desc_gva = 0x200u64;
+        write_task_gva_arm64e(&mut host, &state.tasks[1], desc_gva, &b);
+        let off = list_object_entry_offset(tex_ref, 32).unwrap();
+        let mut le = [0u8; OBJECT_LIST_ENTRY_LEN];
+        st32(
+            &mut le[0..],
+            (OBJECT_TYPE_TEXTURE as u32) | ((body as u32) << 8),
+        );
+        le[4..12].copy_from_slice(&desc_gva.to_le_bytes());
+        write_task_gva_arm64e(&mut host, &state.tasks[1], off, &le);
+        let texel_gva = 1u64 << PAGE_SHIFT_ARM64E;
+        let mut rows = [7u8, 5, 3, 255].repeat(4);
+        rows.extend_from_slice(&[0xAA; 16]); // padding
+        rows.extend_from_slice(&[7u8, 5, 3, 255].repeat(4));
+        write_task_gva_arm64e(&mut host, &state.tasks[1], texel_gva, &rows);
+
+        let (w, h, key) = plain_linear_cache_key(&mut state, &mut host, 1, tex_ref)
+            .expect("a plain linear texture is cacheable");
+        let (lw, lh, _) = load_sampled_rgba(&mut state, &mut host, 1, tex_ref)
+            .expect("the plain load reads the same texture");
+        assert_eq!((w, h), (lw, lh));
+        assert_ne!(key, 0);
+
+        let (_, _, again) = plain_linear_cache_key(&mut state, &mut host, 1, tex_ref).unwrap();
+        assert_eq!(key, again, "unchanged bytes are the same key");
+
+        // Padding the decode never reads does not change the key.
+        write_task_gva_arm64e(&mut host, &state.tasks[1], texel_gva + 16, &[0x55; 16]);
+        let (_, _, padded) = plain_linear_cache_key(&mut state, &mut host, 1, tex_ref).unwrap();
+        assert_eq!(key, padded, "the row padding is not an input to the decode");
+
+        // One texel the guest rewrote is a different key.
+        write_task_gva_arm64e(
+            &mut host,
+            &state.tasks[1],
+            texel_gva + 32 + 4,
+            &[9, 9, 9, 255],
+        );
+        let (_, _, written) = plain_linear_cache_key(&mut state, &mut host, 1, tex_ref).unwrap();
+        assert_ne!(key, written, "a guest write must miss");
+    }
+
     /// A sampled read of a mapper-ref-texture surface is served from this
     /// device's own published frame while the hypervisor's witness says the
     /// guest has not repainted it, and from the surface's own pages otherwise.
