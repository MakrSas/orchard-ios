+/// The rate a process chose and the interval its limiter paces at are one
+/// number: with nothing set they are the defaults the test above pins.
+#[test]
+fn the_chosen_refresh_rate_paces_the_limiter() {
+    if std::env::var_os(crate::config::DISPLAY_HZ).is_none() {
+        assert_eq!(display_refresh_hz(), DISPLAY_REFRESH_HZ);
+        assert_eq!(display_vbl_interval_us(), DISPLAY_VBL_MIN_INTERVAL_US);
+    }
+    assert_eq!(
+        display_vbl_interval_us(),
+        1_000_000 / u64::from(display_refresh_hz())
+    );
+}
+
