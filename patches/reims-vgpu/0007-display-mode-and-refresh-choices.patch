         host.enqueue(HostAction::scanout_gen(
             state.present.frame_mapping,
             width,
@@ -7033,6 +7087,41 @@ pub fn signal_display_present_complete<H: HostMemory + HostOps>(
 pub(crate) const DISPLAY_VBL_MIN_INTERVAL_US: u64 =
     1_000_000 / crate::model::DISPLAY_REFRESH_HZ as u64;
 
+/// The refresh rate this process advertises and paces VBL at: [`DISPLAY_REFRESH_HZ`]
+/// unless [`crate::config::DISPLAY_HZ`] names a slower one. Read once, and
+/// reported once on the failure channel when set, adopted or refused.
+pub(crate) fn display_refresh_hz() -> u32 {
+    static HZ: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *HZ.get_or_init(|| {
+        const NAMES: [&str; 3] = ["120", "60", "30"];
+        match crate::config::choice(crate::config::DISPLAY_HZ, &NAMES) {
+            crate::config::Choice::Unset => DISPLAY_REFRESH_HZ,
+            crate::config::Choice::Named(name) => {
+                let hz = name.parse().unwrap_or(DISPLAY_REFRESH_HZ);
+                crate::observe::fail(format!(
+                    "display_hz_adopted hz={hz} vbl_interval_us={}",
+                    1_000_000 / u64::from(hz)
+                ));
+                hz
+            }
+            crate::config::Choice::Refused(raw) => {
+                crate::observe::fail(format!(
+                    "display_hz_refused value={raw:?} allowed={} \
+                     (the display runs at {DISPLAY_REFRESH_HZ} Hz)",
+                    NAMES.join(",")
+                ));
+                DISPLAY_REFRESH_HZ
+            }
+        }
+    })
+}
+
+/// [`DISPLAY_VBL_MIN_INTERVAL_US`] at the rate [`display_refresh_hz`] chose, so
+/// the interrupt the guest is woken by is the rate its timing table names.
+pub(crate) fn display_vbl_interval_us() -> u64 {
+    1_000_000 / u64::from(display_refresh_hz())
+}
+
