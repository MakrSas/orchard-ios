+/// The timing elements this device offers, in the order it offers them.
+///
+/// Unset [`crate::config::DISPLAY_MODE`] is the default list, 1920x1080 first.
+/// Set, it is the named 16:9 mode first — element 0 is what the guest boots at —
+/// followed by the smaller 16:9 modes, largest first, and none bigger. Read once per process and
+/// reported once on the failure channel, adopted or refused, because it decides
+/// what every later `setupSharedState` publishes.
+fn advertised_display_modes() -> Vec<(u16, u16)> {
+    static MODES: std::sync::OnceLock<Vec<(u16, u16)>> = std::sync::OnceLock::new();
+    MODES.get_or_init(select_display_modes).clone()
+}
+
+fn select_display_modes() -> Vec<(u16, u16)> {
+    let default = vec![
+        (DISPLAY_MODE_EFI_W, DISPLAY_MODE_EFI_H),
+        (DISPLAY_MODE1_W, DISPLAY_MODE1_H),
+        (DISPLAY_MODE2_W, DISPLAY_MODE2_H),
+        (DISPLAY_MODE3_W, DISPLAY_MODE3_H),
+    ];
+    let names = DISPLAY_MODE_CHOICES.map(|(name, _, _)| name);
+    match crate::config::choice(crate::config::DISPLAY_MODE, &names) {
+        crate::config::Choice::Unset => default,
+        crate::config::Choice::Refused(raw) => {
+            crate::observe::fail(format!(
+                "display_mode_refused value={raw:?} allowed={} \
+                 (the default modes are offered, {DISPLAY_MODE_EFI_W}x{DISPLAY_MODE_EFI_H} first)",
+                names.join(",")
+            ));
+            default
+        }
+        crate::config::Choice::Named(name) => {
+            // The named mode and the smaller ones, never a larger one. A guest
+            // restores the mode it last ran at on a display it has seen before
+            // when that mode is on offer: measured on the phone, a macOS guest
+            // named 960x540 booted at it and then went back to 1920x1080 at the
+            // login window — four times the pixels the ask was meant to save.
+            let chosen = DISPLAY_MODE_CHOICES
+                .iter()
+                .find(|(candidate, _, _)| *candidate == name)
+                .map_or(u16::MAX, |(_, width, _)| *width);
+            let modes: Vec<(u16, u16)> = DISPLAY_MODE_CHOICES
+                .iter()
+                .filter(|(_, width, _)| *width <= chosen)
+                .map(|(_, width, height)| (*width, *height))
+                .collect();
+            crate::observe::fail(format!(
+                "display_mode_adopted mode={name} modes={}",
+                modes
+                    .iter()
+                    .map(|(w, h)| format!("{w}x{h}"))
+                    .collect::<Vec<_>>()
+                    .join(",")
+            ));
+            modes
+        }
+    }
+}
