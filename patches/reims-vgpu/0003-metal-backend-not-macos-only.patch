Subject: [PATCH] stop gating five Backend match arms to Metal-on-macOS only

`SelectedBackend::Metal` itself is gated on `feature = "backend-metal"`
alone (backend/mod.rs, the enum definition) — nothing restricts the variant
to macOS. But five of the trait-dispatch match arms for it added an extra
`target_os = "macos"` on top, inconsistent with the enum and with every
other arm for the same variant (e.g. `pay_surface_writeback`, just above
the first of these). All five methods (`pay_surface_writeback`,
`abandon_resident`, `gva_resident`, `gva_witness_key`,
`pay_gva_writeback`) exist for `MetalBackend` purely through the `Backend`
trait's own default (no-op / `None`) implementations — it overrides none
of them — so there is no platform-specific code being protected here.

Building `--no-default-features --features backend-metal` for iOS
(`target_os = "ios"`) hits this directly: the enum variant is present, the
match arms for it are compiled out, and the match is no longer exhaustive
— `error[E0004]: non-exhaustive patterns: type &SelectedBackend is
non-empty`. Dropping `target_os = "macos"` from these five arms, so they
read the same as the enum variant and as every other arm, fixes the build
without changing behavior on macOS (the arms already ran there; they still
do).

---
diff --git a/crates/reims-vgpu/src/backend/mod.rs b/crates/reims-vgpu/src/backend/mod.rs
index 54d149a6..9a7f3f0b 100644
--- a/crates/reims-vgpu/src/backend/mod.rs
+++ b/crates/reims-vgpu/src/backend/mod.rs
@@ -1850,7 +1850,7 @@ impl Backend for SelectedBackend {
         height: u32,
     ) -> bool {
         match self {
-            #[cfg(all(feature = "backend-metal", target_os = "macos"))]
+            #[cfg(feature = "backend-metal")]
             Self::Metal(b) => {
                 b.pay_surface_writeback(state, host, mapping_id, target, width, height)
             }
@@ -1863,7 +1863,7 @@ impl Backend for SelectedBackend {

     fn abandon_resident(&self, target: &ResidentTarget) {
         match self {
-            #[cfg(all(feature = "backend-metal", target_os = "macos"))]
+            #[cfg(feature = "backend-metal")]
             Self::Metal(b) => b.abandon_resident(target),
             #[cfg(feature = "backend-vulkan")]
             Self::Vulkan(b) => b.abandon_resident(target),
@@ -1872,7 +1872,7 @@ impl Backend for SelectedBackend {

     fn gva_resident(&self, debt: &GvaWritebackDebt) -> Option<ResidentTarget> {
         match self {
-            #[cfg(all(feature = "backend-metal", target_os = "macos"))]
+            #[cfg(feature = "backend-metal")]
             Self::Metal(b) => b.gva_resident(debt),
             #[cfg(feature = "backend-vulkan")]
             Self::Vulkan(b) => b.gva_resident(debt),
@@ -1881,7 +1881,7 @@ impl Backend for SelectedBackend {

     fn gva_witness_key(&self, debt: &GvaWritebackDebt) -> Option<GvaTargetKey> {
         match self {
-            #[cfg(all(feature = "backend-metal", target_os = "macos"))]
+            #[cfg(feature = "backend-metal")]
             Self::Metal(b) => b.gva_witness_key(debt),
             #[cfg(feature = "backend-vulkan")]
             Self::Vulkan(b) => b.gva_witness_key(debt),
@@ -1900,7 +1900,7 @@ impl Backend for SelectedBackend {
         skip: crate::runtime::mapping_write::SkipRanges<'_>,
     ) {
         match self {
-            #[cfg(all(feature = "backend-metal", target_os = "macos"))]
+            #[cfg(feature = "backend-metal")]
             Self::Metal(b) => {
                 b.pay_gva_writeback(state, host, task_id, target, c0, texture_ref, pages, skip)
             }
